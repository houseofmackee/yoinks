<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.yoinks</string>
	<key>CFBundleName</key>
	<string>Yoinks</string>
	<key>CFBundleDisplayName</key>
	<string>Yoinks</string>
	<key>CFBundleExecutable</key>
	<string>yoinks</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<!-- Compared by Sparkle: see scripts/version.sh. -->
	<key>CFBundleVersion</key>
	<string>@BUNDLE_VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- Apple Silicon only. -->
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Yoinks</string>
	<!-- Menu bar app: no Dock icon. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- yoinks://add?path=..., yoinks://show, ... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.yoinks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yoinks</string>
			</array>
		</dict>
	</array>
	<!-- "Add to Yoinks" in the Services menu and Finder's Quick Actions. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Yoinks</string>
			</dict>
			<key>NSMessage</key>
			<string>addToYoinks</string>
			<key>NSPortName</key>
			<string>Yoinks</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSSendTypes</key>
			<array>
				<string>public.file-url</string>
				<string>public.url</string>
				<string>public.png</string>
				<string>public.tiff</string>
				<string>public.rtf</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
